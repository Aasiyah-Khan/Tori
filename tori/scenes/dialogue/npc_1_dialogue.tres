[resource]
script = ExtResource("1_36rj7")
openingDialogue = Array[String](["Villager - After months of trying, I have finally gotten an audience with you.", "Villager - Please listen to my request, or rather, complaint", "You - Go on.", "Villager - My neighbor has been very suspicious recently.", "Villager - I see him leaving for somewhere every night.", "Villager - I think he’s up to something."])
yesDialogue = Array[String](["Okay, I'll send someone to keep an eye on him.", "Thank you for bringing this to my attention."])
noDialogue = Array[String](["Surely he's not up to anything nefarious."])
greenChoiceText = "Investigate"
redChoiceText = "Leave it"
metadata/_custom_type_script = "uid://br4ab8xxtyphg"
