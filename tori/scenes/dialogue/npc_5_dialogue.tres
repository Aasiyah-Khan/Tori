[gd_resource type="Resource" script_class="DialogueData" format=3 uid="uid://bhureavhulx5s"]

[ext_resource type="Script" uid="uid://br4ab8xxtyphg" path="res://scripts/dialogue_data.gd" id="1_6lcvh"]

[resource]
script = ExtResource("1_6lcvh")
openingDialogue = Array[String](["Lieutenant- There has been a breach in our border.", "Lieutenant- Our wall was damaged in the last storm and is in need of repair.", "You- How extensive is the damage?", "Lieutenant- Only a hole in the Eastern Wall the size of two giant snails.", "Advisor- If I may intrude, we have no direct threats to our borders. ", "Advisor- An enemy would have to get through the neighboring villages’ borders to reach us", "You- What are you suggesting?", "Advisor- Save our limited resources for more pressing matters", "Advisor- A small breach in the wall poses no threat to our mighty village. "])
yesDialogue = Array[String](["You- Any sized hole in the wall is a threat to our borders.", "You- I'll send workers over there first thing tomorrow.", "Lieutenant- Thank you, sir."])
noDialogue = Array[String](["You- My advisor is right.", "You- I need our workers for other issues.", "You- Thank you for bringing this to my attention, but the wall will have to wait."])
greenChoiceText = "Fix the wall"
redChoiceText = "Save repairs for later"
metadata/_custom_type_script = "uid://br4ab8xxtyphg"
